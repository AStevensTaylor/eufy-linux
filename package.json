{
  "name": "eufy-linux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "sidecar:install": "pnpm --dir sidecar install --ignore-workspace",
    "sidecar:build": "pnpm --dir sidecar build",
    "sidecar:compile": "pnpm --dir sidecar compile",
    "sidecar:test": "pnpm --dir sidecar test",
    "check": "pnpm test && pnpm build && pnpm --dir sidecar typecheck && pnpm --dir sidecar test && cd src-tauri && cargo test && cargo clippy --all-targets"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "jmuxer": "2.1.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  }
}
